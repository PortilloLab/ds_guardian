# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Project-specific local databases or logs
historial_proyectos.json

# Compressed files and documents generated
*.zip
*.docx
*.pdf

# Output charts
plots/

# MkDocs generated site folder
site/

# Build artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
coverage.xml

# Reportes generados por los scripts de validación (son artefactos de ejecución,
